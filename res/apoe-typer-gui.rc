// Resources for apoe-typer-gui: application manifest and version information.
// VER_MAJOR / VER_MINOR / VER_PATCH are passed in by build.rs from Cargo.toml.

#include <winresrc.h>

#ifndef VER_MAJOR
#define VER_MAJOR 0
#define VER_MINOR 0
#define VER_PATCH 0
#endif

#define VER_NUMERIC VER_MAJOR,VER_MINOR,VER_PATCH,0

// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST
1 24 "apoe-typer-gui.manifest"

1 VERSIONINFO
FILEVERSION VER_NUMERIC
PRODUCTVERSION VER_NUMERIC
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "apoe-typer"
            VALUE "FileDescription", "APOE Typer GUI (rs429358 / rs7412)"
            VALUE "InternalName", "apoe-typer-gui"
            VALUE "OriginalFilename", "apoe-typer-gui.exe"
            VALUE "ProductName", "APOE Typer"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
